# Used by both `docker compose` and `pnpm start`. Copy to .env and edit.

# Port on your PC (compose) or the port the app listens on (pnpm start)
PORT=8080
LOG_LEVEL=info
# Set when the app is reached through another address, e.g. http://streampc.lan:8080
PUBLIC_URL=

# docker compose only: 127.0.0.1 = this PC only, 0.0.0.0 = reachable from your LAN
BIND_ADDRESS=127.0.0.1

# pnpm start only
HOST=127.0.0.1
DATA_DIR=./data
